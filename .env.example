# Django Settings
# SECRET_KEY, JWT_SECRET and ENCRYPTION_KEY have NO defaults: the app will not start without them.
# Make each one different. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-django-secret-key-here-generate-with-django-insecure-generate-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.finance-platform.com

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=finance_db
DB_USER=postgres
DB_PASSWORD=your-secure-db-password-here
DB_HOST=localhost
DB_PORT=5432

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Encryption
ENCRYPTION_KEY=your-aes-256-encryption-key-here

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://finance-platform.com

# Security (all default to the safe value when unset: DEBUG false, the three flags below true).
# For LOCAL development only, put DEBUG=True and the three flags as False in your own .env.
# NUM_PROXIES = reverse proxies in front of the app (Railway: 1).
NUM_PROXIES=1
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Environment
ENVIRONMENT=production

# Logging
LOG_LEVEL=INFO

# Email (optional, for email verification)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# PDF OCR (optional, for Tesseract path)
TESSERACT_CMD=/usr/bin/tesseract

# Feature Flags
FEATURE_FLAGS_ENABLE_PDF_PARSING=True
FEATURE_FLAGS_ENABLE_CSV_PARSING=True
FEATURE_FLAGS_ENABLE_RECURRING_DETECTION=True
FEATURE_FLAGS_ENABLE_OUTLIER_FLAGGING=True
